**/.git
**/.DS_Store

# build/ working files (specs, smoke results, local tools)
build/*
!build/Dockerfile.mgmt
!build/Dockerfile.engine
!build/containd-os-shell.sh

# Go build artifacts
**/bin
**/dist
**/*.exe
**/*.test

# Local Go caches (large; never needed in image builds)
.gocache
.gomodcache
.gopath

# Local binaries produced in repo root
containd
ngfw-mgmt
ngfw-engine
smoketest

# UI artifacts
**/node_modules
**/.next
**/out
ui/.turbo
ui/.eslintcache
ui/.swc
ui/coverage
ui/.vercel

# Local data volumes
data

# Local env files (compose reads these; image builds should not)
.env

# Docs not required for image builds (keep MkDocs source used by build/Dockerfile.mgmt)
docs
!docs/mkdocs
!docs/mkdocs.yml
!docs/requirements-mkdocs.txt

