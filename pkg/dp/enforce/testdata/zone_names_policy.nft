  set local4_65746832 {
    type ipv4_addr;
  }
  chain deny_clean {
    meta mark set meta mark & 0xe0ffffff;
    drop;
  }
  chain reset_tcp_clean {
    meta mark set meta mark & 0xe0ffffff;
    reject with tcp reset;
  }
  chain reset_other_clean {
    meta mark set meta mark & 0xe0ffffff;
    reject with icmpx admin-prohibited;
  }
  chain admit_clean {
    meta mark & 0x10000000 != 0 goto deny_clean;
    meta mark set meta mark & 0xe0ffffff;
    accept;
  }
  chain related_clean {
    meta mark & 0x10000000 != 0 goto deny_clean;
    meta mark set meta mark & 0xe0ffffff;
    accept;
  }
  chain admit_unconditional {
    meta mark & 0x10000000 != 0 goto deny_clean;
    ct state != { invalid, untracked } ct mark set (ct mark & 0xfffffff9) | 0x00000002;
    goto admit_clean;
  }
  chain admit_conditional {
    meta mark & 0x10000000 != 0 goto deny_clean;
    ct state != { invalid, untracked } ct mark set ct mark & 0xfffffffd;
    goto admit_clean;
  }
  counter rule_17b5a00bc946a860 { }
  chain ordered_s2_rule_0 {
    meta mark & 0x10000000 != 0 goto deny_clean;
    ct state { invalid, untracked } counter name "rule_17b5a00bc946a860";
    ct state != { invalid, untracked } ct mark & 0x00000001 == 0 counter name "rule_17b5a00bc946a860";
    ct state != { invalid, untracked } ct mark & 0x00000001 != 0 ct mark & 0x00000006 != 0x00000002 counter name "rule_17b5a00bc946a860";
    goto admit_unconditional;
  }
  chain ordered_s2 {
    ct state != { invalid, untracked } ct direction original iifname { "eth1" } oifname { "eth4" } goto ordered_s2_rule_0;
    ct state != { invalid, untracked } ct direction reply iifname { "eth4" } oifname { "eth1" } goto ordered_s2_rule_0;
    ct state { invalid, untracked } iifname { "eth1" } oifname { "eth4" } goto ordered_s2_rule_0;
    goto deny_clean;
  }
  chain input {
    type filter hook input priority 0;
    policy drop;
    iifname "lo" accept;
    ct state { established, related } accept;
    ct state invalid drop;
    ip protocol icmp icmp type { echo-request, echo-reply, destination-unreachable, time-exceeded } accept;
    meta l4proto ipv6-icmp icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept;
    iifname @zone_612d62 tcp dport 22 accept;
    iifname @zone_615f62 tcp dport 22 accept;
    iifname @zone_7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a tcp dport 22 accept;
  }
  chain forward {
    type filter hook forward priority 0;
    policy drop;
    meta mark & 0x10000000 != 0 goto ordered_s2;
    ct state established ct mark & 0x00000007 == 0x00000002 goto admit_clean;
    ct state != related goto ordered_s2;
    ct state related goto related_clean;
  }
  chain prerouting {
    type nat hook prerouting priority dstnat;
    policy accept;
    iifname "eth2" ip daddr @local4_65746832 tcp dport 8443 counter ct mark set ct mark | 0x00000001 dnat ip to 192.0.2.10:443;
  }
  chain postrouting {
    type nat hook postrouting priority srcnat;
    policy accept;
    ct direction original iifname "eth2" ct mark & 0x00000001 != 0 meta l4proto tcp ct original proto-dst 8443 ct original ip daddr @local4_65746832 ct reply ip saddr 192.0.2.10 ct reply proto-src 443 masquerade;
    iifname @zone_412042 oifname @zone_6162 masquerade;
    iifname @zone_612d62 oifname @zone_6162 masquerade;
  }
