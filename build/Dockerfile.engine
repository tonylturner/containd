# syntax=docker/dockerfile:1
#
# Optional: standalone engine image for split mgmt/engine deployments.
# For most users, use build/Dockerfile.mgmt which builds the combined appliance.

FROM --platform=$BUILDPLATFORM golang:1.26.10-alpine AS builder
ARG TARGETARCH
ARG VERSION
ARG COMMIT=unknown

WORKDIR /src
COPY go.mod ./
COPY go.sum ./
RUN go mod download

COPY . .
RUN version="${VERSION:-$(tr -d '\n' < VERSION 2>/dev/null || printf dev)}"; \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -trimpath \
    -ldflags "-s -w -X github.com/tonylturner/containd/pkg/cp/config.BuildVersion=${version} -X github.com/tonylturner/containd/pkg/cp/config.BuildCommit=${COMMIT}" \
    -o /out/containd ./cmd/containd

# Wolfi-based runtime: nftables for enforcement, ClamAV for the engine-owned
# antivirus backend, and CA roots for FreshClam and ICAP over TLS.
FROM cgr.dev/chainguard/wolfi-base:latest@sha256:360896efb0753a5701c48f860e17130c205eae5a264797aa3e7ea126ee2923a7

RUN apk update && apk add --no-cache ca-certificates-bundle clamav nftables && rm -rf /var/cache/apk/*

# ClamAV runtime shared by the engine and combined images. The engine renders
# clamd and FreshClam configs; clamd runs as the clamav account.
RUN addgroup -S clamav \
    && adduser -S -D -H -G clamav -h /var/lib/clamav -s /sbin/nologin clamav \
    && mkdir -p /var/lib/clamav /run/clamav \
    && chown clamav:clamav /var/lib/clamav /run/clamav

# Image metadata comes from the same build args as the binary. Declared
# after the package RUNs, so a new commit does not invalidate those layers.
ARG VERSION
ARG COMMIT=unknown
ARG CREATED
LABEL org.opencontainers.image.title="containd-engine" \
      org.opencontainers.image.description="containd data plane (engine-only)" \
      org.opencontainers.image.url="https://github.com/tonylturner/containd" \
      org.opencontainers.image.source="https://github.com/tonylturner/containd" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.vendor="containd" \
      org.opencontainers.image.authors="https://github.com/tonylturner/containd"

COPY --from=builder /out/containd /usr/bin/containd
# Recorded demo inputs: preserve manifest-relative paths; ship fixture licenses,
# not the generator programs or their software license collections.
COPY test/demo/manifest.json test/demo/NOTICE /usr/share/containd/demo/
COPY test/modbus/testdata/bad-layout.pcap \
    test/modbus/testdata/bad-length.pcap \
    test/modbus/testdata/diagnostics.pcap \
    test/modbus/testdata/operations.pcap \
    test/modbus/testdata/pid-nonzero.pcap \
    test/modbus/testdata/source502.pcap \
    test/modbus/testdata/truncation.pcap \
    test/modbus/testdata/LICENSE \
    /usr/share/containd/demo/test/modbus/testdata/
COPY test/dnp3/testdata/class-range.pcap \
    test/dnp3/testdata/crc-flip.pcap \
    test/dnp3/testdata/crob.pcap \
    test/dnp3/testdata/header-crc.pcap \
    test/dnp3/testdata/iin-error.pcap \
    test/dnp3/testdata/large-response.pcap \
    test/dnp3/testdata/link-only.pcap \
    test/dnp3/testdata/qualifier-tail.pcap \
    test/dnp3/testdata/startup-integrity.pcap \
    test/dnp3/testdata/unsolicited.pcap \
    test/dnp3/testdata/LICENSE \
    /usr/share/containd/demo/test/dnp3/testdata/
COPY test/iec104/testdata/edge-addressing.pcap \
    test/iec104/testdata/malformed.pcap \
    test/iec104/testdata/sbo-command.pcap \
    test/iec104/testdata/session-management.pcap \
    test/iec104/testdata/startup-gi-monitor.pcap \
    test/iec104/testdata/LICENSE \
    /usr/share/containd/demo/test/iec104/testdata/
COPY test/cip/testdata/connected.pcap \
    test/cip/testdata/explicit.pcap \
    test/cip/testdata/io.pcap \
    test/cip/testdata/msp-error.pcap \
    test/cip/testdata/msp.pcap \
    test/cip/testdata/msp32.pcap \
    test/cip/testdata/native-io.pcap \
    test/cip/testdata/udp-short-mutation.pcap \
    test/cip/testdata/LICENSE \
    /usr/share/containd/demo/test/cip/testdata/
COPY test/it/testdata/dns.pcap \
    test/it/testdata/http.pcap \
    test/it/testdata/ntp.pcap \
    test/it/testdata/rdp.pcap \
    test/it/testdata/smb.pcap \
    test/it/testdata/snmp.pcap \
    test/it/testdata/ssh.pcap \
    test/it/testdata/tls.pcap \
    test/it/testdata/LICENSE \
    /usr/share/containd/demo/test/it/testdata/
# The engine needs CONTAIND_ENGINE_ADDR set to its address on the management
# network and CONTAIND_ENGINE_SECRET for mutual TLS. It refuses loopback or
# wildcard listeners in engine mode, except reserved shared-namespace loopback.
EXPOSE 8081
ENTRYPOINT ["/usr/bin/containd"]
CMD ["engine"]
