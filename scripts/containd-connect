#!/usr/bin/env bash
# Print starter Compose connection endpoints. Usage: scripts/containd-connect [service]
# Requires Docker Compose and a running service (default: containd).
set -euo pipefail

service="${1:-containd}"
repo_root="$(cd "$(dirname "$0")/.." && pwd)"
compose=(docker compose)
if [[ -f "$repo_root/.env" ]]; then
  compose+=(--env-file "$repo_root/.env")
fi
compose+=(-f "$repo_root/deploy/docker-compose.yml")

if ! command -v docker >/dev/null 2>&1; then
  echo "docker is required" >&2
  exit 1
fi

ps_out="$("${compose[@]}" ps -q "$service")"
# Some Docker/Compose builds print warnings to stdout; only keep container IDs.
cid="$(printf '%s\n' "$ps_out" | tr -d '\r' | grep -E '^[0-9a-f]{12,64}$' | head -n 1 || true)"
if [[ -z "${cid}" ]]; then
  echo "Service '${service}' is not running."
  echo "Start it with: scripts/containd up"
  exit 1
fi

# Optional ports may be unpublished; keep Compose diagnostics visible on stderr.
http_map="$("${compose[@]}" port "$service" 8080 | tr -d '\r' | head -n 1 || true)"
https_map="$("${compose[@]}" port "$service" 8443 | tr -d '\r' | head -n 1 || true)"
ssh_map="$("${compose[@]}" port "$service" 2222 | tr -d '\r' | head -n 1 || true)"
engine_map="$("${compose[@]}" port "$service" 8081 | tr -d '\r' | head -n 1 || true)"

ips="$(docker inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{printf "%s:%s\n" $k $v.IPAddress}}{{end}}' "$cid" 2>/dev/null | tr -d '\r' || true)"

echo "------------------------------------------------------------"
echo "containd connection helper"
echo "Service: ${service} (container: ${cid:0:12})"
echo ""
echo "Tip: configuration is driven by .env"
echo "  - Start from: .env.example"
echo "  - Edit:       .env (ignored by git)"

echo ""
if [[ -n "${http_map}" ]]; then
  echo "UI/API (host published):"
  if [[ "${http_map%:*}" == "0.0.0.0" ]]; then
    http_map="localhost:${http_map##*:}"
  fi
  echo "  http://${http_map}"
else
  echo "UI/API (host published): not published (no 8080/tcp mapping)"
fi

echo ""
if [[ -n "${https_map}" ]]; then
  echo "UI/API (HTTPS, host published):"
  if [[ "${https_map%:*}" == "0.0.0.0" ]]; then
    https_map="localhost:${https_map##*:}"
  fi
  echo "  https://${https_map} (self-signed by default)"
else
  echo "UI/API (HTTPS, host published): not published (no 8443/tcp mapping)"
fi

echo ""
if [[ -n "${ssh_map}" ]]; then
  echo "SSH CLI (host published):"
  # Compose port prints host:port; assume host is localhost-like.
  host="${ssh_map%:*}"
  port="${ssh_map##*:}"
  if [[ "${host}" == "0.0.0.0" ]]; then
    host="localhost"
  fi
  echo "  ssh -p ${port} containd@${host}"
  echo "  then type: wizard or menu"
else
  echo "SSH CLI (host published): not published (no 2222/tcp mapping)"
fi

echo ""
if [[ -n "${engine_map}" ]]; then
  if [[ "${engine_map%:*}" == "0.0.0.0" ]]; then
    engine_map="localhost:${engine_map##*:}"
  fi
  echo "Engine API (host published): ${engine_map} (non-loopback listeners require mutual TLS; see the Compose guide)"
else
  echo "Engine API (host published): not published (8081 mapping disabled by default)"
fi

if [[ -n "${ips}" ]]; then
  echo ""
  echo "Container IPs (per Docker network):"
  printf "  %s\n" "${ips}"
  echo ""
  echo "Note:"
  echo "  - These are the Docker-managed interface addresses from the starter lab topology."
  echo "  - Change network wiring/subnets in .env or deploy/docker-compose.yml."
  echo "  - Use containd to bind zones and enforce policy on top of that topology."
fi

echo ""
echo "Logs:"
printf '  '
printf '%q ' "${compose[@]}" logs -f "$service"
printf '\n'
echo "------------------------------------------------------------"
